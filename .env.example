# Local Postgres (via `docker compose up -d postgres`, see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denta_bot_dev?schema=public"

# apps/server HTTP port
PORT=4000

# JWT secrets — MUST be two distinct random strings (e.g. `openssl rand -hex 32`), never equal
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Seed script (packages/db/prisma/seed.ts) — first PlatformAdmin bootstrap credentials
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# CORS allowlist — apps/web dev origin (:3000) + apps/platform-admin dev origin (:5173)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Refresh-token cookie config
# REFRESH_COOKIE_DOMAIN empty = localhost; set to a real domain once production topology is decided (D-05)
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=strict
