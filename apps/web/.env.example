# Server-side base URL for the backend API — used by Server Component
# fetch() calls (e.g. Blog/Prices public reads, Phase 6 Plans 06-02/06-03).
API_URL=http://localhost:4000

# Client-side base URL for the backend API — used by browser-side fetch()
# calls from 'use client' components (e.g. Contacts/Demo lead forms).
NEXT_PUBLIC_API_URL=http://localhost:4000
